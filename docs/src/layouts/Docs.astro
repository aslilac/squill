---
// The docs shell: the page shell plus a sidebar. One place to add a doc
// page — the sidebar and the page order both come from this list.
import Footer from "../components/Footer.astro";
import Base from "./Base.astro";

const { title, lede, page } = Astro.props;

const groups = [
	{
		heading: "Getting started",
		items: [
			{ href: "docs/", label: "Overview", key: "overview" },
			{ href: "docs/style/", label: "Style tour", key: "style" },
			{ href: "docs/install/", label: "Install", key: "install" },
			{ href: "docs/editors/", label: "Editors", key: "editors" },
			{ href: "docs/adopting/", label: "Adopting squill", key: "adopting" },
		],
	},
	{
		heading: "Reference",
		items: [
			{ href: "docs/cli/", label: "Command line", key: "cli" },
			{ href: "docs/configuration/", label: "Configuration", key: "configuration" },
			{ href: "docs/embedded/", label: "Embedded SQL", key: "embedded" },
			{ href: "docs/frozen/", label: "Frozen paths", key: "frozen" },
		],
	},
	{
		// Built-in grammars first, then the ones loaded from a URL.
		heading: "Recipes",
		items: [
			["rust", "Rust"],
			["go", "Go"],
			["python", "Python"],
			["javascript", "JavaScript & TypeScript"],
			["gleam", "Gleam"],
			["csharp", "C#"],
			["java", "Java"],
			["kotlin", "Kotlin"],
			["swift", "Swift"],
			["cpp", "C++"],
			["lua", "Lua"],
			["ruby", "Ruby"],
			["elixir", "Elixir"],
		].map(([slug, label]) => ({
			href: `docs/recipes/${slug}/`,
			label,
			key: `recipes/${slug}`,
		})),
	},
];
---

<Base title={title} lede={lede} section="docs" wide>
	<div class="docs-shell">
		<aside class="sidebar">
			<nav aria-label="Documentation">
				{
					groups.map((group) => (
						<>
							<h2>{group.heading}</h2>
							<ul>
								{group.items.map((item) => (
									<li>
										<a
											href={item.href}
											aria-current={item.key === page ? "page" : undefined}
										>
											{item.label}
										</a>
									</li>
								))}
							</ul>
						</>
					))
				}
			</nav>
		</aside>

		<article>
			{title && <h1 class="page-title">{title}</h1>}
			{lede && <p class="page-lede">{lede}</p>}
			<slot />
			<Footer />
		</article>
	</div>
</Base>
