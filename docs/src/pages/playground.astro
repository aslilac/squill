---
import chevronIcon from "lucide-static/icons/chevron-down.svg?raw";
import chevronRightIcon from "lucide-static/icons/chevron-right.svg?raw";
import settingsIcon from "lucide-static/icons/settings.svg?raw";
import { liveRecipe, recipeTitles } from "../components/recipes.js";
import ThemeInit from "../components/ThemeInit.astro";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import "../styles/theme.css";

const baseHref = import.meta.env.BASE_URL;

// The picker's frameworks: every recipe a playground module can format,
// under the language its code is in (a recipe of plain .sql files, like
// Gleam's squirrel, under its page's language), in recipe-page order.
const frameworks = recipeTitles().flatMap(({ name, page, title }) => {
	const recipe = liveRecipe(name);
	if (!recipe) return [];
	const { host, query, options, dialect, source } = recipe;
	const language = host === "sql" ? page : host;
	return [{ name, title, language, host, query, options, dialect, source }];
});
// Inline JSON: `<` escaped so no source can end the script element.
const frameworksJson = JSON.stringify(frameworks).replace(/</g, "\\u003c");
---

<html lang="en">
	<head>
		<base href={baseHref} />
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>squill playground</title>
		<meta
			name="description"
			content="Format SQL live in your browser — squill compiled to WebAssembly."
		/>
		<link rel="icon" type="image/svg+xml" href="squill-fav.svg" />
		<ThemeInit />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Spectral:wght@400;600&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class="toolbar">
			<a class="brand" href=".">
				<img src="squill.svg" width="22" height="22" alt="" />
				<span class="wordmark">squill</span>
			</a>
			<span class="sub">playground</span>
			<div class="picker-wrap">
				<button
					id="picker"
					class="button picker-button"
					type="button"
					aria-haspopup="dialog"
					aria-expanded="false"
					aria-controls="picker-panel"
					title="Language and framework"
				>
					<span id="picker-label">SQL</span>
					<span class="picker-chevron" set:html={chevronIcon} />
				</button>
				<div
					id="picker-panel"
					class="popover picker"
					role="dialog"
					aria-label="Language and framework"
					hidden
				>
					<ul
						class="picker-languages"
						role="listbox"
						aria-label="Language"
					></ul>
					<svg class="picker-aim" aria-hidden="true">
						<polygon />
					</svg>
					<div class="picker-frameworks">
						<p class="picker-heading" id="picker-heading"></p>
						<ul role="listbox" aria-labelledby="picker-heading"></ul>
					</div>
				</div>
			</div>
			<div class="spacer"></div>
			<button id="copy" class="button" title="Copy formatted output">
				copy
			</button>
			<div class="settings-wrap">
				<button
					id="gear"
					class="button icon"
					title="Settings"
					aria-haspopup="true"
					set:html={settingsIcon}
				/>
				<div id="settings" class="popover" hidden>
					<label>
						dialect
						<select data-opt="dialect">
							<option value="postgres">postgres</option>
							<option value="sqlite">sqlite</option>
						</select>
					</label>
					<label>
						indent
						<select data-opt="indent">
							<option value="tab">tabs</option>
							<option value="spaces">spaces</option>
						</select>
					</label>
					<label>
						indent-width
						<input
							data-opt="indent_width"
							type="number"
							min="1"
							max="16"
							value="2"
						/>
					</label>
					<label>
						max-width
						<input
							data-opt="max_width"
							type="number"
							min="20"
							max="500"
							value="80"
						/>
					</label>
					<label>
						keyword-case
						<select data-opt="keyword_case">
							<option value="lower">lower</option>
							<option value="upper">upper</option>
						</select>
					</label>
					<label>
						quote-idents
						<select data-opt="quote_idents">
							<option value="as-needed">as-needed</option>
							<option value="always">always</option>
						</select>
					</label>
					<label>
						trailing-semicolons
						<select data-opt="trailing_semicolons">
							<option value="">by language</option>
							<option value="always">always</option>
							<option value="none">none</option>
						</select>
					</label>
					<label class="row">
						<input data-opt="at_params" type="checkbox" />
						at-params
					</label>
					<label class="row">
						<input data-opt="question_params" type="checkbox" />
						question-params
					</label>
					<label class="row">
						<input data-opt="colon_params" type="checkbox" />
						colon-params
					</label>
					<label class="row">
						<input data-opt="pyformat_params" type="checkbox" />
						pyformat-params
					</label>
				</div>
			</div>
			<ThemeSwitcher />
		</header>

		<main class="panes">
			<section class="pane">
				<div class="pane-label">input</div>
				<div id="editor"></div>
			</section>
			<section class="pane output-pane">
				<div class="pane-label">
					<span>formatted</span>
					<div>
						<span id="status" class="tidy"></span>
						<span id="ms" class="ms" title="Time spent formatting">
							— ms
						</span>
					</div>
				</div>
				<div id="output" class="output">
					<div class="loading">loading the formatter…</div>
				</div>
			</section>
		</main>

		<footer class="console">
			<div class="pane-label">console</div>
			<pre id="console-out">—</pre>
		</footer>

		<script type="application/json" id="frameworks" set:html={frameworksJson} />
		<template id="chevron-right">
			<Fragment set:html={chevronRightIcon} />
		</template>
		<script>
			import * as monaco from "monaco-editor";
			import EditorWorker from "monaco-editor/editor/editor.worker?worker";
			import { highlight, highlightHost } from "../components/highlight.js";
			import { languages, sqlExamples } from "../playground/examples.js";
			import {
				gleamConfiguration,
				gleamLanguage,
			} from "../playground/gleam-monarch.js";
			import { colors, lightColors } from "../playground/theme.js";
			import { charSpans, loadSquill } from "../playground/wasm.js";

			self.MonacoEnvironment = { getWorker: () => new EditorWorker() };

			monaco.languages.register({ id: "gleam" });
			monaco.languages.setMonarchTokensProvider("gleam", gleamLanguage);
			monaco.languages.setLanguageConfiguration("gleam", gleamConfiguration);

			// The editor follows the site's theme: the one pinned in the theme
			// menu, else the system's.
			for (const [name, base, palette] of [
				["squill-dark", "vs-dark", colors],
				["squill-light", "vs", lightColors],
			]) {
				monaco.editor.defineTheme(name, {
					base,
					inherit: true,
					rules: [
						{
							token: "keyword",
							foreground: palette.keyword.slice(1),
							fontStyle: "bold",
						},
						{ token: "string", foreground: palette.string.slice(1) },
						{ token: "string.sql", foreground: palette.string.slice(1) },
						{ token: "number", foreground: palette.number.slice(1) },
						{ token: "comment", foreground: palette.comment.slice(1) },
						{ token: "predefined", foreground: palette.func.slice(1) },
						{ token: "type.identifier", foreground: palette.func.slice(1) },
					],
					colors: {
						"editor.background": palette.bg,
						"editor.foreground": palette.fg,
						"editor.selectionBackground": palette.selection,
						"editorLineNumber.foreground": palette.comment,
					},
				});
			}
			const prefersDark = matchMedia("(prefers-color-scheme: dark)");
			const editorTheme = () =>
				`squill-${document.documentElement.dataset.theme ?? (prefersDark.matches ? "dark" : "light")}`;
			const followTheme = () => monaco.editor.setTheme(editorTheme());
			prefersDark.addEventListener("change", followTheme);
			new MutationObserver(followTheme).observe(document.documentElement, {
				attributes: true,
				attributeFilter: ["data-theme"],
			});

			// ---- page state ----
			const msBadge = document.getElementById("ms");
			const statusBadge = document.getElementById("status");
			const outputPane = document.getElementById("output");
			const consoleOut = document.getElementById("console-out");
			const copyButton = document.getElementById("copy");
			const gear = document.getElementById("gear");
			const settingsPopover = document.getElementById("settings");

			const languageOf = (host) =>
				languages.find((language) => language.host === host);
			// The docs recipes, as the page was built with them.
			const frameworks = JSON.parse(
				document.getElementById("frameworks").textContent,
			);
			// What a language offers: its recipes, then a clean slate.
			const choicesFor = (language) => [
				...(language.host === "sql"
					? sqlExamples.map(({ title, dialect, source }) => ({
							title,
							host: "sql",
							source,
							dialect,
							options: dialect ? { dialect } : {},
						}))
					: []),
				...frameworks.filter(
					(framework) => framework.language === language.host,
				),
				{
					title: "Empty",
					host: language.host,
					source: "",
					options: {},
					empty: true,
				},
			];

			const options = {
				dialect: "postgres",
				indent: "tab",
				indent_width: 2,
				max_width: 80,
				keyword_case: "lower",
				quote_idents: "as-needed",
				at_params: false,
				question_params: false,
				colon_params: false,
				pyformat_params: false,
			};
			let lastGoodOutput = "";
			// The language the code is in, and the recipe's query, if the
			// code came from a recipe with one.
			let current = languageOf("sql");
			let query;

			const editor = monaco.editor.create(document.getElementById("editor"), {
				value: sqlExamples[0].source,
				language: current.monacoLang,
				theme: editorTheme(),
				minimap: { enabled: false },
				overviewRulerBorder: false,
				hideCursorInOverviewRuler: true,
				fontFamily: "JetBrains Mono, monospace",
				fontSize: 13,
				lineHeight: 22,
				scrollBeyondLastLine: false,
				automaticLayout: true,
				tabSize: options.indent_width,
				wordWrap: "off",
			});

			// Each host's formatter is its own module (see wasm.js), loaded
			// the first time a language needs it.
			let version = 0;
			async function render() {
				const language = current;
				const run = ++version;
				const format = await loadSquill(language.host);
				// Another language was picked while this one's module loaded.
				if (run !== version) return;
				const request = {
					source: editor.getValue(),
					host: language.host,
					query,
					options,
				};
				let result;
				try {
					result = format(request);
				} catch (error) {
					consoleOut.textContent = String(error);
					statusBadge.textContent = "✗ error";
					statusBadge.className = "bad";
					return;
				}
				msBadge.textContent = `${Math.ceil(result.ms)} ms`;
				if (result.output == null) {
					// Keep the last good output visible; report in the console.
					consoleOut.textContent =
						result.diagnostics.join("\n") || "unknown error";
					statusBadge.textContent = "✗ error";
					statusBadge.className = "bad";
					return;
				}
				// Host code shows its SQL highlighted as SQL: squill says
				// where it is.
				const output = result.output;
				const html =
					language.host === "sql"
						? await highlight(output, "sql")
						: (
								await highlightHost(
									output,
									language.shikiLang,
									charSpans(output, result.spans),
								)
							).sql;
				if (run !== version) return;
				lastGoodOutput = output;
				outputPane.innerHTML = html;
				// Statements or strings squill left as written come back as
				// diagnostics, beside the output.
				// A clean slate has nothing to find.
				const found =
					language.host === "sql" ||
					result.spans.length > 0 ||
					request.source.trim() === "";
				consoleOut.textContent = result.diagnostics.length
					? result.diagnostics.join("\n")
					: found
						? "—"
						: `${query ? "The recipe's" : `${language.label}'s default`} query found no SQL here.`;
				if (result.diagnostics.length > 0) {
					statusBadge.textContent = `⚠ ${result.diagnostics.length} left as written · `;
					statusBadge.className = "warn";
				} else if (!found) {
					statusBadge.textContent = "no SQL found · ";
					statusBadge.className = "warn";
				} else {
					statusBadge.textContent = "✓ formatted in ";
					statusBadge.className = "tidy";
				}
			}

			// The indent-width setting drives how both panes measure tabs.
			function applyIndentWidth() {
				editor.getModel().updateOptions({ tabSize: options.indent_width });
				outputPane.style.setProperty(
					"--tab-width",
					String(options.indent_width),
				);
			}
			applyIndentWidth();

			let debounce;
			editor.onDidChangeModelContent(() => {
				clearTimeout(debounce);
				debounce = setTimeout(render, 100);
			});

			// ---- the language and framework picker ----
			// Two columns: languages on the left, and on the right whatever
			// the language under the pointer (or focus) offers. Choosing on
			// the right sets the page up and closes the picker.
			const picker = document.getElementById("picker");
			const pickerLabel = document.getElementById("picker-label");
			const panel = document.getElementById("picker-panel");
			const languageList = panel.querySelector(".picker-languages");
			const choiceList = panel.querySelector(".picker-frameworks ul");
			const choiceHeading = document.getElementById("picker-heading");
			const chevron = document.getElementById("chevron-right").innerHTML;
			let chosenLanguage = "sql";
			let shownLanguage;
			// The language under the pointer, if any.
			let hovered;

			const languageItems = languages.map((language) => {
				const item = document.createElement("li");
				item.innerHTML = `<button type="button" role="option" aria-selected="false"><span></span>${chevron}</button>`;
				const button = item.firstElementChild;
				button.firstElementChild.textContent = language.label;
				button.dataset.host = language.host;
				button.addEventListener("pointerenter", () => {
					hovered = language.host;
					aimAt(language);
				});
				button.addEventListener("pointerleave", () => {
					if (hovered === language.host) hovered = undefined;
				});
				button.addEventListener("focus", () => showLanguage(language));
				button.addEventListener("click", () => {
					showLanguage(language);
					choiceList.querySelector("button")?.focus();
				});
				languageList.append(item);
				return button;
			});

			function showLanguage(language) {
				if (shownLanguage === language.host) return;
				shownLanguage = language.host;
				for (const button of languageItems) {
					button.setAttribute(
						"aria-selected",
						String(button.dataset.host === language.host),
					);
				}
				choiceHeading.textContent = language.label;
				choiceList.replaceChildren(
					...choicesFor(language).map((choice) => {
						const item = document.createElement("li");
						const button = document.createElement("button");
						button.type = "button";
						button.role = "option";
						button.textContent = choice.title;
						if (choice.empty) item.className = "picker-empty";
						// SQLite's are marked, however they got there: the
						// config, or a query that pins it (sqlight, GRDB).
						// The SQL examples are named for their dialect.
						if (choice.dialect === "sqlite" && language.host !== "sql") {
							const note = document.createElement("span");
							note.className = "picker-note";
							note.textContent = "SQLite";
							button.append(note);
						}
						button.addEventListener("click", () => choose(language, choice));
						item.append(button);
						return item;
					}),
				);
			}

			// The options a recipe's config sets are its driver's (the
			// dialect and placeholder styles); style options stay yours.
			const driverDefaults = {
				dialect: "postgres",
				at_params: false,
				question_params: false,
				colon_params: false,
				pyformat_params: false,
			};
			function choose(language, choice) {
				chosenLanguage = language.host;
				current = languageOf(choice.host);
				query = choice.query;
				for (const [key, fallback] of Object.entries(driverDefaults)) {
					options[key] = choice.options[key] ?? fallback;
					const control = settingsPopover.querySelector(`[data-opt="${key}"]`);
					if (control.type === "checkbox") control.checked = options[key];
					else control.value = options[key];
				}
				pickerLabel.textContent = choice.empty
					? language.label
					: `${language.label} · ${choice.title}`;
				monaco.editor.setModelLanguage(editor.getModel(), current.monacoLang);
				closePicker(false);
				editor.setValue(choice.source);
				editor.focus();
				render();
			}

			// Menu aim (Ben Kamens' name for the trick Amazon's mega-menu
			// used): a pointer headed for the frameworks column crosses other
			// languages on its way. While it keeps moving into the triangle
			// between itself and the column's left corners, a language it
			// passes over waits, and takes over only once the pointer rests
			// or turns away.
			const AIM_DELAY = 300;
			// Slack above and below the column, for a pointer aimed at its
			// first or last item.
			const AIM_SLACK = 40;
			// Draw the triangle: faint while the pointer moves, stronger
			// while it holds a language back. For watching it work; off.
			const SHOW_AIM = false;
			const choicesColumn = panel.querySelector(".picker-frameworks");
			const aim = panel.querySelector(".picker-aim");
			const aimShape = aim.querySelector("polygon");
			let trail = [];
			let aimTimer;
			let heldAt;

			function corners() {
				const rect = choicesColumn.getBoundingClientRect();
				return [
					{ x: rect.left, y: rect.top - AIM_SLACK },
					{ x: rect.left, y: rect.bottom + AIM_SLACK },
				];
			}

			// Is the pointer heading into the column? Moving toward it, the
			// slope from the pointer to the upper corner falls and the slope
			// to the lower one rises.
			function headingIn() {
				const here = trail.at(-1);
				const before = trail[0];
				if (!here || !before || here === before) return false;
				// Resting where it was held: it's arrived.
				if (heldAt && here.x === heldAt.x && here.y === heldAt.y) return false;
				const [upper, lower] = corners();
				if (here.x >= upper.x) return false;
				const slope = (a, b) => (b.y - a.y) / (b.x - a.x);
				return (
					slope(here, upper) < slope(before, upper) &&
					slope(here, lower) > slope(before, lower)
				);
			}

			function aimAt(language) {
				clearTimeout(aimTimer);
				// Held, and the pointer went on (into the column, say): this
				// language never takes over.
				if (hovered !== language.host) {
					heldAt = undefined;
					drawAim(false);
					return;
				}
				if (shownLanguage && headingIn()) {
					heldAt = trail.at(-1);
					drawAim(true);
					aimTimer = setTimeout(() => aimAt(language), AIM_DELAY);
					return;
				}
				heldAt = undefined;
				drawAim(false);
				showLanguage(language);
			}

			function drawAim(holding) {
				const here = trail.at(-1);
				if (!SHOW_AIM || !here || panel.hidden) {
					aim.classList.remove("visible", "holding");
					return;
				}
				const [upper, lower] = corners();
				// In the column itself there's nothing left to aim at.
				if (here.x >= upper.x) {
					aim.classList.remove("visible", "holding");
					return;
				}
				aimShape.setAttribute(
					"points",
					[here, upper, lower].map(({ x, y }) => `${x},${y}`).join(" "),
				);
				aim.classList.add("visible");
				aim.classList.toggle("holding", holding);
			}

			panel.addEventListener("pointermove", (event) => {
				trail.push({ x: event.clientX, y: event.clientY });
				if (trail.length > 3) trail.shift();
				drawAim(heldAt !== undefined);
			});
			panel.addEventListener("pointerleave", () => {
				trail = [];
				drawAim(false);
			});

			function openPicker() {
				settingsPopover.hidden = true;
				panel.hidden = false;
				picker.setAttribute("aria-expanded", "true");
				shownLanguage = undefined;
				showLanguage(languageOf(chosenLanguage));
				languageItems
					.find((button) => button.dataset.host === chosenLanguage)
					.focus();
			}
			function closePicker(refocus) {
				clearTimeout(aimTimer);
				heldAt = undefined;
				trail = [];
				drawAim(false);
				panel.hidden = true;
				picker.setAttribute("aria-expanded", "false");
				if (refocus) picker.focus();
			}
			picker.addEventListener("click", () =>
				panel.hidden ? openPicker() : closePicker(false),
			);
			document.addEventListener("click", (event) => {
				if (!panel.hidden && !event.target.closest(".picker-wrap")) {
					closePicker(false);
				}
			});

			// Keys: up and down within a column, right into the choices,
			// left back to the languages, Escape out.
			function step(buttons, by) {
				const at = buttons.indexOf(document.activeElement);
				focusItem(buttons[(at + by + buttons.length) % buttons.length]);
			}
			// A language focused by key shows its choices, as one under
			// the pointer does.
			function focusItem(button) {
				button.focus();
				if (button.dataset.host) showLanguage(languageOf(button.dataset.host));
			}
			panel.addEventListener("keydown", (event) => {
				const choices = [...choiceList.querySelectorAll("button")];
				const inLanguages = languageItems.includes(document.activeElement);
				const column = inLanguages ? languageItems : choices;
				if (event.key === "Escape") {
					closePicker(true);
				} else if (event.key === "ArrowDown" || event.key === "ArrowUp") {
					step(column, event.key === "ArrowDown" ? 1 : -1);
				} else if (event.key === "ArrowRight" && inLanguages) {
					choices[0]?.focus();
				} else if (event.key === "ArrowLeft" && !inLanguages) {
					languageItems
						.find((button) => button.dataset.host === shownLanguage)
						.focus();
				} else if (event.key === "Home" || event.key === "End") {
					focusItem(column.at(event.key === "Home" ? 0 : -1));
				} else {
					return;
				}
				event.preventDefault();
			});
			pickerLabel.textContent = `SQL · ${sqlExamples[0].title}`;

			copyButton.addEventListener("click", async () => {
				await navigator.clipboard.writeText(lastGoodOutput);
				copyButton.textContent = "copied!";
				setTimeout(() => (copyButton.textContent = "copy"), 1200);
			});

			gear.addEventListener("click", () => {
				closePicker(false);
				settingsPopover.hidden = !settingsPopover.hidden;
			});
			document.addEventListener("click", (event) => {
				if (
					!settingsPopover.hidden &&
					!event.target.closest(".settings-wrap")
				) {
					settingsPopover.hidden = true;
				}
			});
			for (const control of settingsPopover.querySelectorAll("[data-opt]")) {
				control.addEventListener("change", () => {
					const key = control.dataset.opt;
					options[key] =
						control.type === "checkbox"
							? control.checked
							: control.type === "number"
								? Number(control.value)
