---
import settingsIcon from "lucide-static/icons/settings.svg?raw";
import ThemeInit from "../components/ThemeInit.astro";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import "../styles/theme.css";

const baseHref = import.meta.env.BASE_URL;
---

<html lang="en">
	<head>
		<base href={baseHref} />
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>squill playground</title>
		<meta
			name="description"
			content="Format SQL live in your browser — squill compiled to WebAssembly."
		/>
		<link rel="icon" type="image/svg+xml" href="squill-fav.svg" />
		<ThemeInit />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Spectral:wght@400;600&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class="toolbar">
			<a class="brand" href=".">
				<img src="squill.svg" width="22" height="22" alt="" />
				<span class="wordmark">squill</span>
			</a>
			<span class="sub">playground</span>
			<select id="language" title="Language" aria-label="Language"></select>
			<select id="example" title="Example" aria-label="Example"></select>
			<div class="spacer"></div>
			<button id="copy" class="button" title="Copy formatted output"
				>copy</button
			>
			<div class="settings-wrap">
				<button
					id="gear"
					class="button icon"
					title="Settings"
					aria-haspopup="true"
					set:html={settingsIcon}
				/>
				<div id="settings" class="popover" hidden>
					<label
						>dialect
						<select data-opt="dialect">
							<option value="postgres">postgres</option>
							<option value="sqlite">sqlite</option>
						</select>
					</label>
					<label
						>indent
						<select data-opt="indent">
							<option value="tab">tabs</option>
							<option value="spaces">spaces</option>
						</select>
					</label>
					<label
						>indent-width
						<input
							data-opt="indent_width"
							type="number"
							min="1"
							max="16"
							value="2"
						/>
					</label>
					<label
						>max-width
						<input
							data-opt="max_width"
							type="number"
							min="20"
							max="500"
							value="80"
						/>
					</label>
					<label
						>keyword-case
						<select data-opt="keyword_case">
							<option value="lower">lower</option>
							<option value="upper">upper</option>
						</select>
					</label>
					<label
						>quote-idents
						<select data-opt="quote_idents">
							<option value="as-needed">as-needed</option>
							<option value="always">always</option>
						</select>
					</label>
					<label
						>trailing-semicolons
						<select data-opt="trailing_semicolons">
							<option value="">by language</option>
							<option value="always">always</option>
							<option value="none">none</option>
						</select>
					</label>
					<label class="row">
						<input data-opt="at_params" type="checkbox" />
						at-params
					</label>
					<label class="row">
						<input data-opt="question_params" type="checkbox" />
						question-params
					</label>
					<label class="row">
						<input data-opt="colon_params" type="checkbox" />
						colon-params
					</label>
					<label class="row">
						<input data-opt="pyformat_params" type="checkbox" />
						pyformat-params
					</label>
				</div>
			</div>
			<ThemeSwitcher />
		</header>

		<main class="panes">
			<section class="pane">
				<div class="pane-label">input</div>
				<div id="editor"></div>
			</section>
			<section class="pane output-pane">
				<div class="pane-label">
					<span>formatted</span>
					<div>
						<span id="status" class="tidy"></span>
						<span id="ms" class="ms" title="Time spent formatting">— ms</span>
					</div>
				</div>
				<div id="output" class="output">
					<div class="loading">loading the formatter…</div>
				</div>
			</section>
		</main>

		<footer class="console">
			<div class="pane-label">console</div>
			<pre id="console-out">—</pre>
		</footer>

		<script>
			import * as monaco from "monaco-editor";
			import EditorWorker from "monaco-editor/esm/vs/editor/editor.worker?worker";
			import {
				highlight,
				highlightHost,
			} from "../components/highlight.js";
			import { examples, languages } from "../playground/examples.js";
			import {
				gleamConfiguration,
				gleamLanguage,
			} from "../playground/gleam-monarch.js";
			import { colors, lightColors } from "../playground/theme.js";
			import { charSpans, loadSquill } from "../playground/wasm.js";

			self.MonacoEnvironment = { getWorker: () => new EditorWorker() };

			monaco.languages.register({ id: "gleam" });
			monaco.languages.setMonarchTokensProvider("gleam", gleamLanguage);
			monaco.languages.setLanguageConfiguration("gleam", gleamConfiguration);

			// The editor follows the site's theme: the one pinned in the theme
			// menu, else the system's.
			for (const [name, base, palette] of [
				["squill-dark", "vs-dark", colors],
				["squill-light", "vs", lightColors],
			]) {
				monaco.editor.defineTheme(name, {
					base,
					inherit: true,
					rules: [
						{
							token: "keyword",
							foreground: palette.keyword.slice(1),
							fontStyle: "bold",
						},
						{ token: "string", foreground: palette.string.slice(1) },
						{ token: "string.sql", foreground: palette.string.slice(1) },
						{ token: "number", foreground: palette.number.slice(1) },
						{ token: "comment", foreground: palette.comment.slice(1) },
						{ token: "predefined", foreground: palette.func.slice(1) },
						{ token: "type.identifier", foreground: palette.func.slice(1) },
					],
					colors: {
						"editor.background": palette.bg,
						"editor.foreground": palette.fg,
						"editor.selectionBackground": palette.selection,
						"editorLineNumber.foreground": palette.comment,
					},
				});
			}
			const prefersDark = matchMedia("(prefers-color-scheme: dark)");
			const editorTheme = () =>
				`squill-${document.documentElement.dataset.theme ?? (prefersDark.matches ? "dark" : "light")}`;
			const followTheme = () => monaco.editor.setTheme(editorTheme());
			prefersDark.addEventListener("change", followTheme);
			new MutationObserver(followTheme).observe(document.documentElement, {
				attributes: true,
				attributeFilter: ["data-theme"],
			});

			// ---- page state ----
			const exampleSelect = document.getElementById("example");
			const msBadge = document.getElementById("ms");
			const statusBadge = document.getElementById("status");
			const outputPane = document.getElementById("output");
			const consoleOut = document.getElementById("console-out");
			const copyButton = document.getElementById("copy");
			const gear = document.getElementById("gear");
			const settingsPopover = document.getElementById("settings");

			const languageSelect = document.getElementById("language");
			for (const language of languages) {
				languageSelect.append(new Option(language.label, language.host));
			}
			// Examples are presets: one sets the language and the code. The
			// placeholder stands in once the language is picked by hand.
			exampleSelect.append(new Option("Examples…", ""));
			exampleSelect.options[0].disabled = true;
			for (const [index, example] of examples.entries()) {
				exampleSelect.append(new Option(example.label, String(index)));
			}
			const languageOf = (host) =>
				languages.find((language) => language.host === host);

			const options = {
				dialect: "postgres",
				indent: "tab",
				indent_width: 2,
				max_width: 80,
				keyword_case: "lower",
				quote_idents: "as-needed",
				at_params: false,
				question_params: false,
				colon_params: false,
				pyformat_params: false,
			};
			let lastGoodOutput = "";
			let current = languageOf(examples[0].host);
			languageSelect.value = current.host;
			exampleSelect.value = "0";

			const editor = monaco.editor.create(document.getElementById("editor"), {
				value: examples[0].source,
				language: current.monacoLang,
				theme: editorTheme(),
				minimap: { enabled: false },
				overviewRulerBorder: false,
				hideCursorInOverviewRuler: true,
				fontFamily: "JetBrains Mono, monospace",
				fontSize: 13,
				lineHeight: 22,
				scrollBeyondLastLine: false,
				automaticLayout: true,
				tabSize: options.indent_width,
				wordWrap: "off",
			});

			// Each host's formatter is its own module (see wasm.js), loaded
			// the first time a language needs it.
			let version = 0;
			async function render() {
				const language = current;
				const run = ++version;
				const format = await loadSquill(language.host);
				// Another language was picked while this one's module loaded.
				if (run !== version) return;
				const request = {
					source: editor.getValue(),
					host: current.host,
					options,
				};
				let result;
				try {
					result = format(request);
				} catch (error) {
					consoleOut.textContent = String(error);
					statusBadge.textContent = "✗ error";
					statusBadge.className = "bad";
					return;
				}
				msBadge.textContent = `${Math.ceil(result.ms)} ms`;
				if (result.output == null) {
					// Keep the last good output visible; report in the console.
					consoleOut.textContent =
						result.diagnostics.join("\n") || "unknown error";
					statusBadge.textContent = "✗ error";
					statusBadge.className = "bad";
					return;
				}
				// Host code shows its SQL highlighted as SQL: squill says
				// where it is.
				const output = result.output;
				const html =
					language.host === "sql"
						? await highlight(output, "sql")
						: (
								await highlightHost(
									output,
									language.shikiLang,
									charSpans(output, result.spans),
								)
							).sql;
				if (run !== version) return;
				lastGoodOutput = output;
				outputPane.innerHTML = html;
				// Statements or strings squill left as written come back as
				// diagnostics, beside the output.
				const found = language.host === "sql" || result.spans.length > 0;
				consoleOut.textContent = result.diagnostics.length
					? result.diagnostics.join("\n")
					: found
						? "—"
						: `${language.label}'s default query found no SQL here.`;
				if (result.diagnostics.length > 0) {
					statusBadge.textContent = `⚠ ${result.diagnostics.length} left as written · `;
					statusBadge.className = "warn";
				} else if (!found) {
					statusBadge.textContent = "no SQL found · ";
					statusBadge.className = "warn";
				} else {
					statusBadge.textContent = "✓ formatted in ";
					statusBadge.className = "tidy";
				}
			}

			// The indent-width setting drives how both panes measure tabs.
			function applyIndentWidth() {
				editor.getModel().updateOptions({ tabSize: options.indent_width });
				outputPane.style.setProperty(
					"--tab-width",
					String(options.indent_width),
				);
			}
			applyIndentWidth();

			let debounce;
			editor.onDidChangeModelContent(() => {
				clearTimeout(debounce);
				debounce = setTimeout(render, 100);
			});

			// An example turns on the `*-params` options its driver needs, as
			// its recipe's config would, and the rest off.
			function applyParams(example) {
				for (const key of [
					"at_params",
					"question_params",
					"colon_params",
					"pyformat_params",
				]) {
					options[key] = example.params?.[key] ?? false;
					settingsPopover.querySelector(`[data-opt="${key}"]`).checked =
						options[key];
				}
			}

			function setLanguage(host) {
				current = languageOf(host);
				languageSelect.value = host;
				monaco.editor.setModelLanguage(editor.getModel(), current.monacoLang);
			}

			exampleSelect.addEventListener("change", () => {
				const example = examples[Number(exampleSelect.value)];
				applyParams(example);
				setLanguage(example.host);
				editor.setValue(example.source); // triggers render via the change event
			});

			// A language picked by hand keeps the code (yours, pasted in) and
			// the options; only an example brings its own.
			languageSelect.addEventListener("change", () => {
				setLanguage(languageSelect.value);
				exampleSelect.value = "";
				render();
			});

			copyButton.addEventListener("click", async () => {
				await navigator.clipboard.writeText(lastGoodOutput);
				copyButton.textContent = "copied!";
				setTimeout(() => (copyButton.textContent = "copy"), 1200);
			});

			gear.addEventListener("click", () => {
				settingsPopover.hidden = !settingsPopover.hidden;
			});
			document.addEventListener("click", (event) => {
				if (
					!settingsPopover.hidden &&
					!event.target.closest(".settings-wrap")
				) {
					settingsPopover.hidden = true;
				}
			});
			for (const control of settingsPopover.querySelectorAll("[data-opt]")) {
				control.addEventListener("change", () => {
					const key = control.dataset.opt;
					options[key] =
						control.type === "checkbox"
							? control.checked
							: control.type === "number"
								? Number(control.value)
								: // An empty choice ("by language") sends nothing,
									// leaving the host's default.
									control.value || undefined;
					applyIndentWidth();
					render();
				});
			}

			render();
		</script>

		<style is:global>
			/* The site's colors (styles/theme.css), plus the playground's own. */
			:root {
				--top: light-dark(#e9e4f0, #241f2e);
				--violet-solid: oklch(0.53 0.17 293);
				--ok: light-dark(oklch(0.5 0.13 155), oklch(0.68 0.13 155));
				--bad: light-dark(oklch(0.55 0.18 25), oklch(0.7 0.15 25));
				--caution: light-dark(oklch(0.55 0.12 75), oklch(0.78 0.12 80));
				--gutter: light-dark(#b5aec0, #4a4453);
			}
			* {
				box-sizing: border-box;
			}
			html,
			body {
				height: 100%;
			}
			body {
				margin: 0;
				display: flex;
				flex-direction: column;
				background: var(--paper);
				color: var(--ink);
				font:
					14px/1.5 "IBM Plex Sans",
					system-ui,
					sans-serif;
			}

			.toolbar {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				padding: 0.55rem 0.9rem;
				background: var(--top);
				border-bottom: 1px solid var(--edge);
			}
			.brand {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				text-decoration: none;
				color: inherit;
			}
			.wordmark {
				font-family: "Spectral", serif;
				font-weight: 600;
				font-size: 1.1rem;
				color: var(--ink);
			}
			.sub {
				font-size: 0.9rem;
				color: var(--muted);
			}
			.spacer {
				flex: 1;
			}
			.ms {
				font-family: "JetBrains Mono", monospace;
				font-size: 0.72rem;
				color: var(--ok);
				min-width: 4.5rem;
				text-align: right;
			}
			select,
			.button,
			.popover input {
				font:
					500 0.78rem "IBM Plex Sans",
					sans-serif;
				color: var(--pane-text);
				background: var(--pane);
				border: 1px solid var(--edge);
				border-radius: 7px;
				padding: 0.35rem 0.6rem;
			}
			.button {
				cursor: pointer;
			}
			.button:hover {
				border-color: var(--violet-solid);
			}
			.button.icon {
				display: flex;
				align-items: center;
				padding: 0.3rem 0.45rem;
			}
			.button.icon svg {
				width: 15px;
				height: 15px;
				stroke: currentColor;
			}

			/* The theme menu's button, dressed like the toolbar's other
			   icon buttons rather than the site's round one. */
			.toolbar .theme-switcher .theme-button {
				width: auto;
				height: auto;
				padding: 0.3rem 0.45rem;
				border: 1px solid var(--edge);
				border-radius: 7px;
				background: var(--pane);
				color: var(--pane-text);
			}
			.toolbar .theme-switcher .theme-button:hover,
			.toolbar .theme-switcher .theme-button[aria-expanded="true"] {
				border-color: var(--violet-solid);
				background: var(--pane);
				color: var(--pane-text);
			}
			.toolbar .theme-switcher .theme-button svg {
				width: 15px;
				height: 15px;
			}

			.settings-wrap {
				position: relative;
			}
			.popover[hidden] {
				display: none;
			}
			.popover {
				position: absolute;
				right: 0;
				top: calc(100% + 8px);
				z-index: 10;
				display: flex;
				flex-direction: column;
				gap: 0.55rem;
				width: 18rem;
				padding: 1rem;
				background: var(--pane);
				border: 1px solid var(--edge);
				border-radius: 10px;
				box-shadow: 0 8px 30px light-dark(rgb(34 29 43 / 0.12), rgb(0 0 0 / 0.45));
			}
			.popover label {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.6rem;
				font-family: "JetBrains Mono", monospace;
				font-size: 0.72rem;
				color: var(--muted);
			}
			.popover label.row {
				justify-content: flex-start;
			}
			.popover select,
			.popover input[type="number"] {
				width: 7.5rem;
			}

			.panes {
				flex: 1;
				display: grid;
				grid-template-columns: 1fr 1fr;
				min-height: 0;
			}
			.pane {
				display: flex;
				flex-direction: column;
				min-width: 0;
				min-height: 0;
			}
			.pane + .pane {
				border-left: 1px solid var(--edge);
			}
			.pane-label {
				display: flex;
				justify-content: space-between;
				font-family: "JetBrains Mono", monospace;
				font-size: 0.65rem;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: var(--muted);
				padding: 0.5rem 1rem 0.35rem;
			}
			#editor {
				flex: 1;
				min-height: 0;
			}
			.output-pane {
				background: var(--pane-deep);
			}
			.output {
				flex: 1;
				overflow: auto;
			}
			.output .loading {
				font-family: "JetBrains Mono", monospace;
				font-size: 0.8rem;
				color: var(--muted);
				padding: 1rem;
			}
			.output pre {
				margin: 0;
				padding: 0.3rem 0 1rem;
				font-size: 13px;
				line-height: 22px;
				tab-size: var(--tab-width, 2);
				background: transparent !important;
			}
			/* CSS tab stops are measured from the line box start, and an inline
			gutter would shift the first tab stop by its own width. */
			.output code {
				display: block;
				white-space: normal;
				counter-reset: line;
			}
			.output code {
				display: block;
				white-space: normal;
				counter-reset: line;
			}
			.output .line {
				display: block;
				position: relative;
				white-space: pre;
				min-height: 22px;
				counter-increment: line;
				padding-left: 4.3rem;
				padding-right: 1rem;
			}
			.output .line::before {
				content: counter(line);
				position: absolute;
				left: 0;
				width: 3.2rem;
				text-align: right;
				color: var(--gutter);
				font-family: "JetBrains Mono", monospace;
				user-select: none;
			}
			.tidy {
				color: var(--ok);
			}
			.warn {
				color: var(--caution);
			}
			.bad {
				color: var(--bad);
			}

			.console {
				border-top: 1px solid var(--edge);
				background: var(--pane);
				max-height: 9rem;
				display: flex;
				flex-direction: column;
			}
			.console pre {
				margin: 0;
				padding: 0 1rem 0.7rem;
				overflow: auto;
				font:
					12px/1.6 "JetBrains Mono",
					monospace;
				color: var(--muted);
			}
			@media (max-width: 800px) {
				.panes {
					grid-template-columns: 1fr;
					grid-template-rows: 1fr 1fr;
				}
				.pane + .pane {
					border-left: none;
					border-top: 1px solid var(--edge);
				}
			}
		</style>
	</body>
</html>
