---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const before = `select w.id, w.name, count(*) as build_count from workspaces w join workspace_builds wb on wb.workspace_id = w.id where w.deleted = false and w.last_used_at > NOW() - interval '30 days' group by w.id, w.name order by build_count desc limit 20;

CREATE FUNCTION notify_workspace_change() RETURNS trigger SECURITY DEFINER AS $$ BEGIN PERFORM pg_notify('workspaces', NEW.id::text); RETURN NEW; END; $$ LANGUAGE plpgsql;`;

const after = `select w.id, w.name, count(*) as build_count
from workspaces w
\tjoin workspace_builds wb on wb.workspace_id = w.id
where w.deleted = false and w.last_used_at > now() - interval '30 days'
group by w.id, w.name
order by build_count desc
limit 20;

create function notify_workspace_change()
returns trigger
language plpgsql
security definer
as $$
\tbegin
\t\tperform pg_notify('workspaces', NEW.id::text);
\t\treturn NEW;
\tend;
$$;`;

const baseHref = import.meta.env.BASE_URL;
---

<html lang="en">
	<head>
		<base href={baseHref} />
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>squill, SQL formatter</title>
		<meta
			name="description"
			content="A fast, trustworthy SQL formatter for Postgres and SQLite, with embedded-SQL support for Rust, Go, Python, JavaScript/TypeScript, and Gleam."
		/>
		<link rel="icon" type="image/svg+xml" href={`${base}/squill-fav.svg`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,400;0,500;0,600;1,500&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<main>
			<nav>
				<div class="brand">
					<img src="/squill-mark.svg" width="28" height="28" alt="" />
					<span class="wordmark">squill</span>
				</div>
				<div class="links">
					<a href="https://tree.ht/birds/squill">Source</a>
					<span class="badge">v0.1 · MPL-2.0</span>
				</div>
			</nav>

			<header>
				<div class="masthead">
					<img src="/squill.svg" width="72" height="72" alt="" />
					<div>
						<h1>squill</h1>
						<p class="tagline">
							A robust, friendly, flexible SQL code formatter for everywhere.
						</p>
					</div>
				</div>
				<p>
					Postgres and SQLite. Every statement squill rewrites is
					<em>self-checked</em>: the output must re-lex to the same tokens —
					allowing only named, verified transforms like keyword case and
					pg_dump's clause order — and keep every comment, or squill emits your
					original bytes untouched. Output is never less correct than input.
				</p>
				<p class="flower">
					named for the nodding squill — a small wild bloom that leans like a
					weeping lily
				</p>
			</header>

			<section class="card">
				<div class="label">01 — before &amp; after</div>
				<div class="panes">
					<div class="toolbar">
						<img src="squill-mark-white.svg" width="18" height="18" alt="" />
						<span class="toolbar-name">squill</span>
						<span class="toolbar-note">fmt</span>
						<span class="chip">postgres</span>
					</div>
					<div class="pair">
						<figure>
							<figcaption>input</figcaption>
							<pre><code>{before}</code></pre>
						</figure>
						<figure>
							<figcaption>
								formatted <span class="tidy">✓ tidy</span>
							</figcaption>
							<pre><code>{after}</code></pre>
						</figure>
					</div>
				</div>
			</section>

			<section class="card">
				<div class="label">02 — fast</div>
				<p>
					The entire SQL corpus of <a href="https://github.com/coder/coder"
						>coder/coder</a
					> — 1,255 files, 36,000+ lines of migrations, queries, and fixtures — formats
					in about <strong>215&nbsp;ms</strong>. A single 15,000-line file takes <strong
						>94&nbsp;ms</strong
					>. Fast enough for pre-commit, save-on-format, everything.
				</p>
			</section>

			<section class="card">
				<div class="label">03 — install</div>
				<pre
					class="dark"><code>cargo install --git https://tree.ht/birds/squill.git cli

squill fmt path/to/queries/</code></pre>
			</section>

			<section class="card">
				<div class="label">04 — settings</div>
				<p>
					Configured in the nearest <code>squill.toml</code>, overridable with
					flags. The defaults are the house style; everything is optional.
				</p>
				<table>
					<thead>
						<tr><th>key</th><th>values</th><th>default</th></tr>
					</thead>
					<tbody>
						<tr>
							<td><code>dialect</code></td>
							<td><code>postgres</code> | <code>sqlite</code></td>
							<td><code>postgres</code></td>
						</tr>
						<tr>
							<td><code>indent</code></td>
							<td><code>tab</code> | <code>spaces</code></td>
							<td><code>tab</code></td>
						</tr>
						<tr>
							<td><code>indent-width</code></td>
							<td>width of one level (and tab measure)</td>
							<td><code>2</code></td>
						</tr>
						<tr>
							<td><code>keyword-case</code></td>
							<td><code>lower</code> | <code>upper</code></td>
							<td><code>lower</code></td>
						</tr>
						<tr>
							<td><code>quote-idents</code></td>
							<td><code>unquote-safe</code> | <code>always</code></td>
							<td><code>unquote-safe</code></td>
						</tr>
						<tr>
							<td><code>at-params</code></td>
							<td>lex sqlc-style <code>@name</code> parameters</td>
							<td><code>false</code></td>
						</tr>
					</tbody>
				</table>
			</section>

			<section class="card">
				<div class="label">05 — sql in your source code</div>
				<p>
					squill also formats SQL embedded in host languages, located with
					tree-sitter queries: <code>sqlx::query!</code> in Rust,
					<code>database/sql</code> calls in Go, <code>cursor.execute</code> in Python
					(with <code>%s</code> placeholders preserved),
					<code>db.query</code> and <code>sql`…`</code> templates in JavaScript/TypeScript,
					and <code>sqlight</code>/<code>pog</code> in Gleam. Only multiline string
					syntaxes are rewritten; anything with interpolation holes is never touched.
				</p>
			</section>

			<footer>
				<p>
					Built by Kayla at treehut · source at
					<a href="https://tree.ht/birds/squill">tree.ht/birds/squill</a>
				</p>
			</footer>
		</main>

		<style>
			:root {
				color-scheme: light dark;
				--violet: light-dark(oklch(0.53 0.17 293), oklch(0.72 0.15 293));
				--violet-deep: light-dark(oklch(0.44 0.16 293), oklch(0.8 0.12 293));
				--ink: light-dark(#221d2b, #e6e1ee);
				--paper: light-dark(#f4f1f8, #131019);
				--card: light-dark(#ffffff, #1c1824);
				--edge: light-dark(#e7e2ee, #322b3e);
				--muted: light-dark(#6f6878, #8a8296);
				--inset: light-dark(#faf8fd, #191520);
				--pane: #1c1824;
				--pane-deep: #191520;
				--pane-top: #241f2e;
				--pane-edge: #322b3e;
				--pane-text: #cfc7db;
				--green: oklch(0.68 0.13 155);
			}
			* {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				font:
					15px/1.6 "IBM Plex Sans",
					system-ui,
					sans-serif;
				color: var(--ink);
				background: var(--paper);
			}
			main {
				max-width: 64rem;
				margin: 0 auto;
				padding: 2rem 1.25rem 4rem;
			}
			::selection {
				background: light-dark(oklch(0.9 0.05 293), oklch(0.4 0.1 293));
			}

			nav {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0.75rem 1.1rem;
				border: 1px solid var(--edge);
				border-radius: 12px;
				background: var(--card);
			}
			.brand {
				display: flex;
				align-items: center;
				gap: 0.6rem;
			}
			.wordmark {
				font-family: "Spectral", serif;
				font-weight: 600;
				font-size: 1.25rem;
				letter-spacing: -0.01em;
			}
			.links {
				display: flex;
				align-items: center;
				gap: 1rem;
			}
			.badge {
				font-family: "JetBrains Mono", monospace;
				font-size: 0.7rem;
				font-weight: 600;
				background: light-dark(oklch(0.95 0.03 293), #241f2e);
				color: var(--violet-deep);
				padding: 0.3rem 0.7rem;
				border-radius: 999px;
			}

			header {
				padding: 2.75rem 0.25rem 1rem;
			}
			.masthead {
				display: flex;
				align-items: center;
				gap: 1.1rem;
			}
			h1 {
				font-family: "Spectral", serif;
				font-size: 3.2rem;
				font-weight: 600;
				letter-spacing: -0.02em;
				margin: 0;
				line-height: 1;
			}
			.tagline {
				font-family: "Spectral", serif;
				font-style: italic;
				font-size: 1.25rem;
				color: var(--violet);
				margin: 0.4rem 0 0;
			}
			header > p {
				max-width: 44rem;
			}
			.flower {
				font-family: "Spectral", serif;
				font-style: italic;
				color: var(--muted);
				font-size: 0.95rem;
			}

			.card {
				background: var(--card);
				border: 1px solid var(--edge);
				border-radius: 18px;
				padding: 1.8rem 2rem;
				margin-top: 1.75rem;
			}
			.label {
				font-family: "JetBrains Mono", monospace;
				font-size: 0.7rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--violet);
				margin-bottom: 1.1rem;
			}
			.aside {
				font-family: "JetBrains Mono", monospace;
				font-size: 0.75rem;
				color: var(--muted);
				margin-top: 1rem;
			}

			.panes {
				border: 1px solid var(--pane-edge);
				border-radius: 14px;
				overflow: hidden;
				background: var(--pane);
			}
			.toolbar {
				display: flex;
				align-items: center;
				gap: 0.6rem;
				padding: 0.7rem 1rem;
				background: var(--pane-top);
				border-bottom: 1px solid var(--pane-edge);
			}
			.toolbar-name {
				font-family: "Spectral", serif;
				font-weight: 600;
				font-size: 1rem;
				color: #fff;
			}
			.toolbar-note {
				font-family: "JetBrains Mono", monospace;
				font-size: 0.7rem;
				color: #8a8296;
			}
			.chip {
				margin-left: auto;
				font-family: "JetBrains Mono", monospace;
				font-size: 0.7rem;
				color: #8a8296;
				border: 1px solid #3a3348;
				border-radius: 7px;
				padding: 0.25rem 0.6rem;
			}
			.pair {
				display: grid;
				grid-template-columns: 1fr;
			}
			@media (min-width: 900px) {
				.pair {
					grid-template-columns: 1fr 1fr;
				}
			}
			.pair figure {
				margin: 0;
				min-width: 0;
				display: flex;
				flex-direction: column;
			}
			.pair figure + figure {
				background: var(--pane-deep);
			}
			@media (min-width: 900px) {
				.pair figure:first-child {
					border-right: 1px solid var(--pane-edge);
				}
			}
			.pair figcaption {
				font-family: "JetBrains Mono", monospace;
				font-size: 0.65rem;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: #6f6878;
				padding: 0.7rem 1rem 0.2rem;
				display: flex;
				justify-content: space-between;
			}
			.tidy {
				color: var(--green);
			}
			.pair pre {
				margin: 0;
				padding: 0.3rem 1rem 1.1rem;
				overflow-x: auto;
				color: var(--pane-text);
				font-size: 0.8rem;
				line-height: 1.7;
				tab-size: 4;
			}
			code {
				font-family: "JetBrains Mono", monospace;
			}

			pre.dark {
				background: var(--pane);
				color: var(--pane-text);
				border: 1px solid var(--pane-edge);
				border-radius: 12px;
				padding: 1rem 1.2rem;
				overflow-x: auto;
				font-size: 0.85rem;
				line-height: 1.6;
			}
			section p code,
			td code {
				background: var(--inset);
				border: 1px solid var(--edge);
				border-radius: 5px;
				padding: 0.05rem 0.35rem;
				font-size: 0.85em;
			}

			table {
				border-collapse: collapse;
				width: 100%;
			}
			th,
			td {
				text-align: left;
				padding: 0.5rem 0.75rem;
				border-bottom: 1px solid var(--edge);
			}
			th {
				font-family: "JetBrains Mono", monospace;
				font-size: 0.7rem;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				color: var(--muted);
			}
			a {
				color: var(--violet);
				text-decoration: none;
			}
			a:hover {
				color: var(--violet-deep);
			}
			footer {
				margin-top: 3rem;
				text-align: center;
				font-family: "JetBrains Mono", monospace;
				font-size: 0.75rem;
				color: var(--muted);
			}
		</style>
	</body>
</html>
