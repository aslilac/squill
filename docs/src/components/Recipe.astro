---
// One recipe from docs/recipes/<name>: its config and query files, then
// its before and after. The files are the ones crates/cli/tests/recipes.rs
// checks — `after` is squill's real output for `before` — so the page
// shows them exactly as written and never needs syncing by hand.
import { readFileSync, readdirSync } from "node:fs";
import { join, resolve } from "node:path";
import CopyButton from "./CopyButton.astro";
import settingsIcon from "lucide-static/icons/settings-2.svg?raw";
import { highlight as shiki, highlightHost } from "./highlight.js";
import { liveRecipe } from "./recipes.js";

const { name, lang } = Astro.props;

// Astro runs from docs/, next to the recipes.
const dir = resolve(process.cwd(), "recipes", name);
const read = (path: string) => readFileSync(join(dir, path), "utf8");

// How a language is named in a pane's corner, where shiki's id differs.
const labels: Record<string, string> = { cxx: "c++", csharp: "c#" };
const label = (id: string) => labels[id] ?? id;

// Every file the reader would write, in the order they'd write them:
// the config, then any queries. squill.lock is squill's to write.
const files = readdirSync(dir, { recursive: true, withFileTypes: true })
	.filter((entry) => entry.isFile())
	.map((entry) => join(entry.parentPath, entry.name).slice(dir.length + 1))
	.filter((path) => path.startsWith("squill.") || path.endsWith(".scm"))
	.filter((path) => path !== "squill.lock")
	.sort(
		(a, b) =>
			Number(!a.startsWith("squill.")) - Number(!b.startsWith("squill.")) ||
			a.localeCompare(b),
	);

const all = readdirSync(dir);
const before = all.find((file) => file.startsWith("before."));
const after = all.find((file) => file.startsWith("after."));
const highlight = (code: string, as = lang) => shiki(code.trimEnd(), as);
// Host code comes in two versions, its SQL highlighted or left as plain
// string, for the page-wide toggle; a plain .sql recipe is SQL either way.
const host = async (file) => {
	if (lang === "sql") {
		const html = await highlight(read(file));
		return { sql: html, plain: html };
	}
	const code = read(file).trimEnd();
	return highlightHost(code, lang, spans(file, code));
};
// Where squill finds SQL in a file: spans.jsonl is `squill locate --json`
// for the recipe, byte offsets that become string offsets here.
const located = read("spans.jsonl")
	.split("\n")
	.filter(Boolean)
	.map((line) => JSON.parse(line));
const spans = (file, code) => {
	const bytes = Buffer.from(code);
	const at = (byte) => bytes.subarray(0, byte).toString().length;
	return located
		.filter((span) => span.path === file)
		.map((span) => [at(span.start), at(span.end)]);
};
const panes = [
	{ tab: "before", ...(await host(before)) },
	{ tab: "after", ...(await host(after)) },
];
// What each config-side file is written in, for its caption and colors.
const kind = (path: string) =>
	path.endsWith(".scm") ? "query" : path.endsWith(".toml") ? "toml" : "yaml";

// Live recipes: where there's a playground wasm module for the grammar
// (every built-in has one; see scripts/build-wasm.sh), the after pane can
// be reformatted in the browser with other style options, and the config
// pane shows the keys that would do it. Found from the
// config: the rule covering `before`, its grammar and query, and every
// option it (or the top level) sets.
const recipe = liveRecipe(name);
const live = recipe && {
	...recipe,
	lang,
	// What each style setting is when left alone, for its menu.
	defaults: {
		indent:
			recipe.options.indent ?? (recipe.host === "sql" ? "tabs" : "the file's"),
		indent_width:
			recipe.options.indent_width ?? (recipe.host === "sql" ? 2 : "the file's"),
		max_width: recipe.options.max_width ?? 80,
		keyword_case: recipe.options.keyword_case ?? "lower",
		quote_idents: recipe.options.quote_idents ?? "as-needed",
		trailing_semicolons:
			recipe.options.trailing_semicolons ??
			(recipe.host === "sql" ? "always" : "none"),
	},
};
// The view menu: the SQL highlighting switch for host code, and the style
// options for a live recipe.
const menu = lang !== "sql" || live;
const settings = live && [
	{ key: "indent", label: "indent", values: ["tabs", "spaces"] },
	{ key: "indent_width", label: "indent-width", values: [2, 4, 8] },
	{ key: "max_width", label: "max-width", values: [40, 60, 80, 100, 120] },
	{ key: "keyword_case", label: "keyword-case", values: ["lower", "upper"] },
	{
		key: "quote_idents",
		label: "quote-idents",
		values: ["as-needed", "always"],
	},
	{
		key: "trailing_semicolons",
		label: "trailing-semicolons",
		values: ["always", "none"],
	},
];
---

<div class="recipe" data-live={live ? JSON.stringify(live) : undefined}>
	<div class="pair stacked">
		{files.map(async (path) => (
			<figure data-file={path}>
				<figcaption>
					<span class="filename">{path}</span>
					<span class="caption-tools">
						<span>{kind(path)}</span>
						<CopyButton />
					</span>
				</figcaption>
				<div set:html={await highlight(read(path), kind(path))} />
			</figure>
		))}
	</div>
	<div class="pair stacked" data-tabs data-current="after">
		<figure>
			<figcaption class="tabbar">
				<span role="tablist">
					{panes.map(({ tab }) => (
						<button
							type="button"
							role="tab"
							data-tab={tab}
							aria-selected={tab === "after"}
						>
							{tab}
						</button>
					))}
				</span>
				<span class="tab-tools">
					{menu && (
						<span class="recipe-menu">
							<button
								type="button"
								class="recipe-gear"
								popovertarget={`menu-${name}`}
								title="View options"
								aria-label="View options"
								set:html={settingsIcon}
							/>
							<div class="recipe-popover" id={`menu-${name}`} popover>
								{lang !== "sql" && (
									<button
										type="button"
										class="sql-toggle"
										role="switch"
										aria-checked="true"
									>
										sql highlighting
										<span class="switch" aria-hidden="true" />
									</button>
								)}
								{live && (
									<div class="live-options">
										<p class="menu-heading">style options, for the after tab</p>
										{settings.map(({ key, label, values }) => (
											<label>
												{label}
												<select data-option={key}>
													<option value="">{`default (${live.defaults[key]})`}</option>
													{values
														.filter((value) => value !== live.defaults[key])
														.map((value) => (
															<option value={String(value)}>
																{String(value)}
															</option>
														))}
												</select>
											</label>
										))}
										<span class="live-status" aria-live="polite" />
										<button type="button" class="live-reset">
											reset
										</button>
									</div>
								)}
							</div>
						</span>
					)}
					<span>{label(lang)}</span>
				</span>
			</figcaption>
			{panes.map(({ tab, sql, plain }) => (
				<div
					role="tabpanel"
					data-panel={tab}
					hidden={tab !== "after"}
					data-pane={tab}
				>
					<div class="sql-on" set:html={sql} />
					<div class="sql-off" set:html={plain} />
				</div>
			))}
		</figure>
	</div>
</div>

<script>
	import "./live-recipe.js";

	// Tabs switch within one recipe; the SQL toggle is page-wide, and
	// remembered.
	const root = document.documentElement;
	const setPlain = (plain: boolean) => {
		root.classList.toggle("plain-sql", plain);
		for (const button of document.querySelectorAll(".sql-toggle")) {
			button.setAttribute("aria-checked", String(!plain));
		}
	};
	try {
		setPlain(localStorage.getItem("squill.plain-sql") === "1");
	} catch {}
	document.addEventListener("click", (event) => {
		const target = event.target as Element;
		const tab = target.closest<HTMLElement>("[data-tab]");
		if (tab) {
			const tabs = tab.closest<HTMLElement>("[data-tabs]")!;
			tabs.dataset.current = tab.dataset.tab;
			for (const other of tabs.querySelectorAll("[data-tab]")) {
				other.setAttribute("aria-selected", String(other === tab));
			}
			for (const panel of tabs.querySelectorAll<HTMLElement>("[data-panel]")) {
				panel.hidden = panel.dataset.panel !== tab.dataset.tab;
			}
		}
		if (target.closest(".sql-toggle")) {
			const plain = !root.classList.contains("plain-sql");
			setPlain(plain);
			try {
				localStorage.setItem("squill.plain-sql", plain ? "1" : "0");
			} catch {}
		}
	});
</script>
