---
// A highlighted code block: the same pane as the recipes, with the
// file it belongs in as its caption when there is one, and a button that
// copies it: in the caption, or in the pane's corner without one. Output
// shown rather than run (`copy={false}`) goes without the button. The
// code comes as a prop, not as children, so nothing collapses its
// whitespace on the way.
import CopyButton from "./CopyButton.astro";
import { highlight } from "./highlight.js";

const { lang, code, file, copy = true } = Astro.props;
---

<div
	class:list={[
		"pair",
		"stacked",
		"code-block",
		{ captioned: file, copyable: copy },
	]}
>
	<figure>
		{file ? (
			<figcaption>
				<span class="filename">{file}</span>
				{copy && (
					<span class="caption-tools">
						<CopyButton />
					</span>
				)}
			</figcaption>
		) : (
			copy && <CopyButton />
		)}
		<div set:html={await highlight(code.trim(), lang)} />
	</figure>
</div>
