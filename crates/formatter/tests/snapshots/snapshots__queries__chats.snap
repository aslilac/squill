			updated_chat.last_model_config_id,
			updated_chat.last_reasoning_effort,
			updated_chat.archived,
			updated_chat.last_error,
			updated_chat.mode,
			updated_chat.mcp_server_ids,
			updated_chat.labels,
			updated_chat.build_id,
			updated_chat.agent_id,
