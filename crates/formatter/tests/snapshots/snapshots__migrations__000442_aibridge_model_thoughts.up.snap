create table aibridge_model_thoughts (
	interception_id UUID not null,
	content text not null,
	metadata jsonb,
	created_at TIMESTAMPTZ not null
);

comment on table aibridge_model_thoughts is 'Audit log of model thinking in intercepted requests in AI Bridge';

create index idx_aibridge_model_thoughts_interception_id
	on aibridge_model_thoughts (interception_id);
