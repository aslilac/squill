create type new_logintype as enum ('password', 'github', 'oidc', 'token');

alter table users alter column login_type drop default,
alter column login_type type new_logintype using (
	login_type::text::new_logintype
),
alter column login_type set default 'password'::new_logintype;

alter table user_links alter column login_type type new_logintype using (
	login_type::text::new_logintype
);

alter table api_keys alter column login_type type new_logintype using (
	login_type::text::new_logintype
);

drop type login_type;
alter type new_logintype rename to login_type;
