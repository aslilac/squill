-- Groups/communities now get deleted when the last member leaves. This is a one time cleanup to remove old groups/communities that were already empty before that change was made.
delete from group_attestations_remote
where
	group_id in (
		select group_id
		from groups
		where
			not exists (
				select group_id
				from group_users
				where group_id = groups.group_id
			)
	);
delete from group_attestations_renewals
where
	group_id in (
		select group_id
		from groups
		where
			not exists (
				select group_id
				from group_users
				where group_id = groups.group_id
			)
	);
