---
source: crates/formatter/tests/snapshots.rs
expression: formatted
---
alter table ciphers add column favorite boolean not null default 0; -- FALSE

-- Transfer favorite status for user-owned ciphers.
update ciphers
set favorite = 1
where
	exists (
		select *
		from favorites
		where
			favorites.user_uuid = ciphers.user_uuid
			and favorites.cipher_uuid = ciphers.uuid
	);

drop table favorites;
