---
source: crates/formatter/tests/snapshots.rs
expression: formatted
---
alter table only users add column if not exists rbac_roles text [ ] default '{}' not null;

-- All users are site members. So give them the standard role.
-- Also give them membership to the first org we retrieve. We should only have
-- 1 organization at this point in the product.
update users
set
	rbac_roles = array [
		'member',
		'organization-member:' || (select id from organizations limit 1)
	];

-- Give the first user created the admin role
update users
set rbac_roles = rbac_roles || array ['admin']
where id = (select id from users order by created_at asc limit 1)
