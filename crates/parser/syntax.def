# Squill syntax definition.
#
# Parsed by crates/parser/build.rs, which generates:
#   - the SyntaxKind enum (all token + node kinds),
#   - the typed AST accessor layer included by src/ast.rs.
#
# Format (indentation-sensitive, `#` starts a comment line):
#   token NAME [trivia]  — a token kind; `trivia` marks whitespace/comments
#   node NAME            — a node kind, optionally followed by indented
#                          accessor lines generated as methods:
#     one   name Kind    -> fn name() -> Option<Kind<'_>>       (first child node)
#     many  name Kind    -> fn name() -> impl Iterator<Kind>    (all child nodes)
#     token name Kind    -> fn name() -> Option<&SyntaxToken>   (first child token)

# ---- tokens ----

# Unrecognized input, or an unterminated string/comment spanning to EOF.
token Error
token Whitespace trivia
token LineComment trivia
token BlockComment trivia

# Bare identifier or keyword (keywords are resolved by the parser).
token Ident
# Delimited identifier: "..." or SQLite `...` / [...].
token QuotedIdent
token String
token EscapeString
token UnicodeString
token BitString
token HexString
token DollarString
token Number
token Param

token LParen
token RParen
token LBracket
token RBracket
token Comma
token Semicolon
token Dot
token Colon
token ColonColon
token Operator

# ---- nodes ----

node Root
  many statements Statement

# Generic statement node, used by the tree-builder tests' toy grammar.
node Statement
  token semicolon Semicolon

# A statement that failed to parse; contains its raw tokens verbatim.
node ErrorStatement
# A bare `;` with nothing before it.
node EmptyStmt

# ---- DML statements ----

node InsertStmt
node UpdateStmt
node DeleteStmt
node SetClause
node SetItem
node OnConflictClause
node ReturningClause
node UsingClause

# ---- PL/pgSQL (function-body statements) ----

node PlBlock
node PlDeclare
node PlIf
node PlElsif
node PlElse
node PlCase
node PlWhen
node PlLoop
node PlWhile
node PlFor
node PlForeach
node PlExit
node PlReturn
node PlRaise
node PlAssign
node PlPerform
node PlExecute
node PlGetDiag
node PlNull
node PlException
# `INTO [STRICT] targets` inside body SQL (SELECT/RETURNING/EXECUTE).
node PlInto

# ---- DDL and utility statements ----

# Structured-but-tolerant DDL: leading keywords, top-level commas split
# action lists, parenthesized element lists become ElementList/ColumnDef,
# and expression positions (DEFAULT, CHECK, index expressions, AS query)
# hold real expression/query nodes.
node DdlStmt
node ElementList
node ColumnDef

# ---- SELECT statements ----

node SelectStmt
  one with_clause WithClause
  one order_by OrderByClause
  one limit_clause LimitClause
  one offset_clause OffsetClause
  one fetch_clause FetchClause
  token semicolon Semicolon
node WithClause
  many ctes Cte
node Cte
node SearchClause
node CycleClause
node SelectCore
  one select_list SelectList
  one from_clause FromClause
  one where_clause WhereClause
  one group_by GroupByClause
  one having HavingClause
  one window_clause WindowClause
node SetOperation
node ParenSelect
node ValuesClause
node TableCore
node SelectList
  many items SelectItem
node SelectItem
node FromClause
node TableRef
node ParenTableRef
node JoinExpr
node JoinCondition
node Alias
node WhereClause
node GroupByClause
node GroupingElement
node HavingClause
node WindowClause
node WindowDef
node WindowSpec
node FrameClause
node OrderByClause
  many terms OrderingTerm
node OrderingTerm
node LimitClause
node OffsetClause
node FetchClause
node LockingClause

# ---- expressions ----

node Literal
node ColumnRef
node ParenExpr
node RowExpr
node ArrayExpr
node SubqueryExpr
node QuantifiedExpr
node CaseExpr
node WhenClause
node FunctionCall
node ArgList
node FilterClause
node WithinGroupClause
node OverClause
node CastExpr
node TypeName
node PrefixExpr
node BinaryExpr
node IsExpr
node BetweenExpr
node InExpr
node SubscriptExpr
